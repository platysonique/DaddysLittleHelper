[Unit]
Description=DaddysLittleHelper local bridge
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/daddyslittlehelper
ExecStart=/usr/bin/node bridge/server.js
Restart=on-failure
RestartSec=2
Environment=DLH_HOST=127.0.0.1
Environment=DLH_PORT=3847
Environment=DLH_ROOT=%h/Projects/DaddysLittleHelper

[Install]
WantedBy=default.target
